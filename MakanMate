        // Tab Switching Logic
        function switchTab(tabId) {
            ['today', 'portion', 'planner', 'feedback'].forEach(id => {
                document.getElementById(`tab-${id}`).classList.add('hidden');
            });
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            
            if (tabId === 'planner') renderPlanner();
            if (tabId === 'feedback') renderFeedbackFeed();
        }

        // Live Meal Determination
        function updateLiveStatus() {
            const now = new Date();
            const day = now.getDay(); // 0 = Sun, 5 = Fri, 6 = Sat, 1-4 = Mon-Thu
            let dayKey = 'monday';
            if (day === 1) dayKey = 'monday';
            if (day === 2) dayKey = 'tuesday';
            if (day === 3) dayKey = 'wednesday';
            if (day === 4) dayKey = 'thursday';
            if (day === 5) dayKey = 'friday';
            if (day === 6) dayKey = 'saturday';
            if (day === 0) dayKey = 'sunday';

            const meals = schedules[dayKey].meals;
            let currentMeal = meals[2]; // Default to Lunch for immediate display
            
            document.getElementById('live-meal-title').innerText = `${currentMeal.name}: ${currentMeal.main}`;
            document.getElementById('live-meal-time').innerText = `Scheduled Time: ${currentMeal.time} (${schedules[dayKey].title}) | Side: ${currentMeal.veg}`;
            document.getElementById('live-status-badge').innerText = "🟢 Serving Now";

            // Update today's macros container with exact grams
            document.getElementById('today-macros').innerHTML = `
                <span class="bg-red-50 text-red-700 border border-red-200 px-3 py-1.5 rounded text-xs font-bold">💪 Protein: ${currentMeal.p}</span>
                <span class="bg-blue-50 text-blue-700 border border-blue-200 px-3 py-1.5 rounded text-xs font-bold">🌾 Carbs: ${currentMeal.c}</span>
                <span class="bg-gray-100 text-gray-800 border border-gray-300 px-3 py-1.5 rounded text-xs font-bold">🥑 Fats: ${currentMeal.f}</span>
                <span class="bg-green-50 text-green-700 border border-green-200 px-3 py-1.5 rounded text-xs font-bold">🥗 Fiber: ${currentMeal.fi}</span>
            `;
        }

        // Render Weekly Planner with unique daily items and explicit macro grams
        function renderPlanner(filterQuery = '') {
            const container = document.getElementById('schedule-container');
            container.innerHTML = '';

            Object.keys(schedules).forEach(dayKey => {
                const dayObj = schedules[dayKey];
                const filteredMeals = dayObj.meals.filter(m => 
                    m.name.toLowerCase().includes(filterQuery.toLowerCase()) ||
                    m.main.toLowerCase().includes(filterQuery.toLowerCase()) ||
                    m.drink.toLowerCase().includes(filterQuery.toLowerCase())
                );

                if (filteredMeals.length > 0) {
                    let html = `
                        <div class="bg-white rounded-xl shadow overflow-hidden border-t-4 border-app-blue">
                            <div class="bg-app-textDark text-white px-5 py-3 font-bold text-sm tracking-wide flex justify-between items-center">
                                <span>${dayObj.title}</span>
                                <span class="text-xs bg-app-red text-white px-2 py-0.5 rounded">Active Menu</span>
                            </div>
                            <div class="divide-y divide-gray-100">
                    `;
                    filteredMeals.forEach(m => {
                        html += `
                            <div class="p-4 flex flex-col md:flex-row justify-between items-start md:items-center hover:bg-gray-50 transition">
                                <div class="mb-2 md:mb-0">
                                    <div class="flex items-center space-x-2">
                                        <span class="bg-gray-200 text-app-textDark text-xs font-bold px-2 py-0.5 rounded">#${m.no} ${m.name}</span>
                                        <span class="text-xs text-gray-500 font-medium">${m.time}</span>
                                    </div>
                                    <p class="font-bold text-gray-800 mt-1">${m.main}</p>
                                    <p class="text-xs text-gray-600">Side/Veg: ${m.veg} | Drink: ${m.drink}</p>
                                </div>
                                <div class="flex items-center gap-2 mt-2 md:mt-0">
                                    <span class="text-[11px] bg-red-50 text-red-700 font-bold px-2 py-1 rounded">P: ${m.p}</span>
                                    <span class="text-[11px] bg-blue-50 text-blue-700 font-bold px-2 py-1 rounded">C: ${m.c}</span>
                                    <span class="text-[11px] bg-gray-100 text-gray-700 font-bold px-2 py-1 rounded">F: ${m.f}</span>
                                    <span class="text-[11px] bg-green-50 text-green-700 font-bold px-2 py-1 rounded">Fi: ${m.fi}</span>
                                </div>
                            </div>
                        `;
                    });
                    html += `</div></div>`;
                    container.innerHTML += html;
                }
            });
        }

        function filterMenu() {
            const query = document.getElementById('menu-search').value;
            renderPlanner(query);
        }

        // Feedback Submission
        function submitFeedback(e) {
            e.preventDefault();
            const category = document.getElementById('fb-category').value;
            const meal = document.getElementById('fb-meal').value;
            const text = document.getElementById('fb-text').value;
            const isAnon = document.getElementById('fb-anon').checked;

            const newEntry = {
                id: feedbackData.length + 1,
                category,
                meal,
                text,
                author: isAnon ? 'Anonymous Student' : 'Verified Student',
                status: 'Pending',
                reply: ''
            };

            feedbackData.unshift(newEntry);
            document.getElementById('feedback-form').reset();
            renderFeedbackFeed();
            alert('Feedback successfully submitted to the Food Committee & Kitchen Staff!');
        }

        function renderFeedbackFeed() {
            const feed = document.getElementById('feedback-feed');
            feed.innerHTML = '';
            feedbackData.forEach(item => {
                let badgeColor = 'bg-yellow-100 text-yellow-800';
                if (item.status === 'Resolved by Kitchen') badgeColor = 'bg-green-100 text-green-800';
                if (item.status === 'Under Review') badgeColor = 'bg-blue-100 text-blue-800';

                feed.innerHTML += `
                    <div class="p-4 rounded-lg bg-gray-50 border border-gray-200 space-y-2">
                        <div class="flex justify-between items-center text-xs">
                            <span class="font-bold text-app-blue">${item.category} (${item.meal})</span>
                            <span class="px-2 py-0.5 rounded-full font-semibold ${badgeColor}">${item.status}</span>
                        </div>
                        <p class="text-sm text-gray-800">${item.text}</p>
                        <div class="flex justify-between items-center text-xs text-gray-500 pt-2 border-t border-gray-200">
                            <span>By: ${item.author}</span>
                            ${item.reply ? `<span class="text-app-red font-semibold">Staff Reply: ${item.reply}</span>` : '<span class="italic text-gray-400">Awaiting staff reply</span>'}
                        </div>
                    </div>
                `;
            });
        }

        // Staff Portal PIN Verification (1234)
        function openStaffModal() {
            document.getElementById('staff-passcode').value = '';
            document.getElementById('passcode-error').classList.add('hidden');
            document.getElementById('staff-modal').classList.remove('hidden');
        }

        function closeStaffModal() {
            document.getElementById('staff-modal').classList.add('hidden');
        }

        function verifyStaff() {
            const pin = document.getElementById('staff-passcode').value;
            if (pin === '1234') {
                closeStaffModal();
                openDashboard();
            } else {
                document.getElementById('passcode-error').classList.remove('hidden');
            }
        }

        function openDashboard() {
            renderStaffFeedbackList();
            document.getElementById('staff-dashboard').classList.remove('hidden');
        }

        function closeDashboard() {
            document.getElementById('staff-dashboard').classList.add('hidden');
        }

        function saveMenuOverride() {
            const main = document.getElementById('override-main').value;
            const side = document.getElementById('override-side').value;
            if (main) {
                document.getElementById('today-main').innerHTML = `<p class="font-medium text-app-red">${main} (Staff Override)</p>`;
            }
            if (side) {
                document.getElementById('today-sides').innerHTML = `<p class="font-medium text-app-red">${side} (Staff Override)</p>`;
            }
            alert('Today\'s menu successfully updated across student portals!');
        }

        function renderStaffFeedbackList() {
            const list = document.getElementById('staff-feedback-list');
            list.innerHTML = '';
            feedbackData.forEach((item, index) => {
                list.innerHTML += `
                    <div class="p-3 bg-gray-50 border rounded text-xs space-y-2">
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-gray-800">${item.category} - ${item.meal}</span>
                            <select onchange="updateStatus(${index}, this.value)" class="border rounded p-1 font-semibold">
                                <option value="Pending" ${item.status==='Pending'?'selected':''}>Pending</option>
                                <option value="Under Review" ${item.status==='Under Review'?'selected':''}>Under Review</option>
                                <option value="Resolved by Kitchen" ${item.status==='Resolved by Kitchen'?'selected':''}>Resolved by Kitchen</option>
                            </select>
                        </div>
                        <p class="text-gray-600">"${item.text}" — <span class="italic">${item.author}</span></p>
                        <div class="flex gap-2">
                            <input type="text" id="reply-${index}" placeholder="Type staff reply..." value="${item.reply}" class="border p-1 rounded flex-grow">
                            <button onclick="saveReply(${index})" class="bg-app-blue text-white px-3 py-1 rounded font-bold">Send Reply</button>
                        </div>
                    </div>
                `;
            });
        }

        function updateStatus(index, newStatus) {
            feedbackData[index].status = newStatus;
        }

        function saveReply(index) {
            const replyText = document.getElementById(`reply-${index}`).value;
            feedbackData[index].reply = replyText;
            feedbackData[index].status = 'Resolved by Kitchen';
            renderStaffFeedbackList();
            alert('Staff reply posted successfully!');
        }

        // Initialize on page load
        window.onload = function() {
            updateLiveStatus();
            renderPlanner();
            renderFeedbackFeed();
        }
    </script>
