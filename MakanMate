            <div class="flex items-center space-x-3 mb-2 md:mb-0">
                <!-- Cute Rice Bowl Mascot Logo -->
                <div class="w-10 h-10 bg-white rounded-full p-0.5 shadow border-2 border-app-blue flex items-center justify-center overflow-hidden">
                    <svg viewBox="0 0 500 500" class="w-full h-full object-cover">
                        <circle cx="250" cy="250" r="240" fill="#DC2626"/>
                        <ellipse cx="250" cy="180" rx="180" ry="90" fill="#FFF8E8"/>
                        <circle cx="200" cy="150" r="25" fill="#2563EB"/>
                        <circle cx="320" cy="140" r="25" fill="#2563EB"/>
                        <circle cx="260" cy="120" r="30" fill="#2563EB"/>
                        <rect x="170" y="220" width="160" height="180" rx="20" fill="#DC2626"/>
                        <ellipse cx="170" cy="300" rx="35" ry="30" fill="white"/>
                        <ellipse cx="330" cy="300" rx="35" ry="30" fill="white"/>
                        <circle cx="175" cy="295" r="12" fill="#111827"/>
                        <circle cx="325" cy="295" r="12" fill="#111827"/>
                        <path d="M 230 310 Q 250 330 270 310" stroke="#111827" stroke-width="10" stroke-linecap="round" fill="none"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-wide flex items-center gap-2">
                        MakanMate <span class="text-xs bg-app-red text-white px-2 py-0.5 rounded font-black">PORTAL</span>
                    </h1>
                    <p class="text-xs text-gray-400">Boarding School Dining & Nutrition Management</p>
                </div>
            </div>
            <!-- Navigation Tabs (Unified Theme Color: Red, Blue, Grey, Black) -->
            <nav class="flex flex-wrap gap-2 text-sm font-medium">
                <button onclick="switchTab('today')" id="btn-today" class="px-3 py-1.5 rounded bg-app-red text-white font-semibold transition shadow-sm">Today's Menu</button>
                <button onclick="switchTab('portion')" id="btn-portion" class="px-3 py-1.5 rounded bg-app-blue text-white hover:bg-app-darkBlue transition">Portion Guide</button>
                <button onclick="switchTab('planner')" id="btn-planner" class="px-3 py-1.5 rounded bg-app-blue text-white hover:bg-app-darkBlue transition">Weekly Planner</button>
                <button onclick="switchTab('feedback')" id="btn-feedback" class="px-3 py-1.5 rounded bg-app-blue text-white hover:bg-app-darkBlue transition">Feedback Hub</button>
                <button onclick="openStaffModal()" id="btn-staff" class="px-3 py-1.5 rounded bg-app-darkRed text-white border border-app-blue hover:bg-app-red transition">Staff Portal 🔒</button>
            </nav>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-6">

        <!-- 1. TODAY'S MENU TAB -->
        <section id="tab-today" class="space-y-6">
            <!-- Live Status Banner -->
            <div class="bg-gradient-to-r from-app-textDark to-app-darkBlue text-white p-6 rounded-xl shadow-lg border-l-8 border-app-red flex flex-col md:flex-row justify-between items-center">
                <div>
                    <div class="flex items-center space-x-2">
                        <span class="inline-block w-3 h-3 bg-green-400 rounded-full animate-pulse"></span>
                        <span class="text-xs uppercase tracking-wider text-gray-300 font-bold">Dining Hall Live Status</span>
                    </div>
                    <h2 id="live-meal-title" class="text-2xl font-black mt-1">Loading Current Meal...</h2>
                    <p id="live-meal-time" class="text-sm text-gray-300 mt-1">Schedule timing will display here.</p>
                </div>
                <div class="mt-4 md:mt-0 text-right">
                    <span id="live-status-badge" class="px-4 py-2 rounded-full text-sm font-bold bg-app-red text-white shadow">Checking Schedule...</span>
                </div>
            </div>

            <!-- Meal Breakdown Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Main Items -->
                <div class="bg-white p-5 rounded-xl shadow border-t-4 border-app-red">
                    <h3 class="font-bold text-app-textDark text-lg mb-3 flex items-center justify-between">
                        <span>Main Dish</span>
                        <span class="text-xs bg-red-100 text-red-800 px-2 py-0.5 rounded font-semibold">High Protein</span>
                    </h3>
                    <div id="today-main" class="space-y-2">
                        <p class="font-medium text-gray-900">Ayam Masak Lemak Cili Padi</p>
                        <p class="text-xs text-gray-500">Tender chicken simmered in rich coconut turmeric gravy with bird's eye chilies.</p>
                    </div>
                </div>
                <!-- Side & Veg -->
                <div class="bg-white p-5 rounded-xl shadow border-t-4 border-app-blue">
                    <h3 class="font-bold text-app-textDark text-lg mb-3 flex items-center justify-between">
                        <span>Sides & Vegetables</span>
                        <span class="text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded font-semibold">Vitamins</span>
                    </h3>
                    <div id="today-sides" class="space-y-2">
                        <p class="font-medium text-gray-900">Sup Sayur Campur & Ikan Masin</p>
                        <p class="text-xs text-gray-500">Cabbage, carrots, and tofu soup with crispy salted fish.</p>
                    </div>
                </div>
                <!-- Fruit & Drink -->
                <div class="bg-white p-5 rounded-xl shadow border-t-4 border-app-textDark">
                    <h3 class="font-bold text-app-textDark text-lg mb-3 flex items-center justify-between">
                        <span>Fruit & Beverage</span>
                        <span class="text-xs bg-gray-200 text-gray-800 px-2 py-0.5 rounded font-semibold">Hydration</span>
                    </h3>
                    <div id="today-drink" class="space-y-2">
                        <p class="font-medium text-gray-900">Fresh Watermelon Slices & Air Sirap Ros</p>
                        <p class="text-xs text-gray-500">Chilled sweet melon and refreshing rose cordial drink.</p>
                    </div>
                </div>
            </div>

            <!-- Detailed Gram Macros & Allergens Bar -->
            <div class="bg-white p-6 rounded-xl shadow flex flex-col md:flex-row justify-between items-center border border-gray-200">
                <div class="mb-4 md:mb-0 w-full md:w-auto">
                    <h4 class="font-bold text-gray-700 text-sm mb-2">Detailed Nutritional Grams (Per Serving)</h4>
                    <div id="today-macros" class="grid grid-cols-2 md:grid-cols-4 gap-3">
                        <span class="bg-red-50 text-red-700 border border-red-200 px-3 py-1.5 rounded text-xs font-bold">💪 Protein: 42g</span>
                        <span class="bg-blue-50 text-blue-700 border border-blue-200 px-3 py-1.5 rounded text-xs font-bold">🌾 Carbs: 75g</span>
                        <span class="bg-gray-100 text-gray-800 border border-gray-300 px-3 py-1.5 rounded text-xs font-bold">🥑 Fats: 18g</span>
                        <span class="bg-green-50 text-green-700 border border-green-200 px-3 py-1.5 rounded text-xs font-bold">🥗 Fiber: 8g</span>
                    </div>
                </div>
                <div>
                    <h4 class="font-bold text-gray-700 text-sm mb-1 md:text-right">Allergen Advisories</h4>
                    <div class="flex gap-2">
                        <span class="bg-amber-100 text-amber-800 text-xs px-2.5 py-1 rounded-full font-medium">Contains Dairy/Coconut</span>
                        <span class="bg-amber-100 text-amber-800 text-xs px-2.5 py-1 rounded-full font-medium">Fish Derivatives</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2. PORTION GUIDE TAB -->
        <section id="tab-portion" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-xl shadow border-l-8 border-app-blue">
                <h2 class="text-2xl font-bold text-app-textDark">Visual Portion Guide ("MyPlate" for Student Athletes)</h2>
                <p class="text-gray-600 text-sm mt-1">Optimized for boarding scholars balancing rigorous academics and sports. Use your hand as your natural measuring scale.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div class="bg-white p-5 rounded-xl shadow text-center border-t-4 border-app-red">
                    <div class="text-3xl mb-2">🥩</div>
                    <h3 class="font-bold text-lg text-gray-800">Protein</h3>
                    <p class="text-xs font-semibold text-app-red mt-1">Palm Size & Thickness</p>
                    <p class="text-xs text-gray-500 mt-2">Chicken, fish, beef, or tofu to repair muscle tissue after sports practice (~30-40g protein).</p>
                </div>
                <div class="bg-white p-5 rounded-xl shadow text-center border-t-4 border-app-blue">
                    <div class="text-3xl mb-2">🍚</div>
                    <h3 class="font-bold text-lg text-gray-800">Carbohydrates</h3>
                    <p class="text-xs font-semibold text-app-blue mt-1">Cupped Hand Size</p>
                    <p class="text-xs text-gray-500 mt-2">Rice, noodles, or bread for sustained study and training energy (~60-80g carbs).</p>
                </div>
                <div class="bg-white p-5 rounded-xl shadow text-center border-t-4 border-emerald-600">
                    <div class="text-3xl mb-2">🥦</div>
                    <h3 class="font-bold text-lg text-gray-800">Vegetables</h3>
                    <p class="text-xs font-semibold text-emerald-600 mt-1">Fist Size Portion</p>
                    <p class="text-xs text-gray-500 mt-2">Fiber, vitamins, and minerals for immunity and digestive health (~6-10g fiber).</p>
                </div>
                <div class="bg-white p-5 rounded-xl shadow text-center border-t-4 border-app-textDark">
                    <div class="text-3xl mb-2">💧</div>
                    <h3 class="font-bold text-lg text-gray-800">Hydration</h3>
                    <p class="text-xs font-semibold text-app-textDark mt-1">6-8 Glasses Daily</p>
                    <p class="text-xs text-gray-500 mt-2">Water and isotonic drinks, especially during hot afternoon co-curriculars.</p>
                </div>
            </div>
        </section>

        <!-- 3. WEEKLY PLANNER TAB -->
        <section id="tab-planner" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-xl shadow flex flex-col md:flex-row justify-between items-center border border-gray-200">
                <div>
                    <h2 class="text-2xl font-bold text-app-textDark">Official Boarding Dining Schedule & Unique Daily Menus</h2>
                    <p class="text-gray-600 text-sm mt-1">Search through all scheduled daily meals with explicit grams of protein, carbs, fats, and fiber.</p>
                </div>
                <div class="mt-4 md:mt-0 w-full md:w-auto">
                    <input type="text" id="menu-search" placeholder="Search dish (e.g. Ayam, Nasi, Mee)..." onkeyup="filterMenu()" class="px-4 py-2 border rounded-lg w-full md:w-64 focus:outline-none focus:ring-2 focus:ring-app-blue text-sm">
                </div>
            </div>

            <!-- Schedule Rules Info Box -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-medium">
                <div class="bg-gray-100 p-4 rounded-lg text-gray-900 border border-gray-300 shadow-sm">
                    <strong class="block text-sm font-bold mb-1 text-app-textDark">📅 Weekdays (Mon - Thu)</strong>
                    1. Breakfast (6:30 - 7:15)<br>2. Teabreak (10:45 - 11:15)<br>3. Lunch (2:15 - 3:15)<br>4. Evening tea (4:15 - 5:00)<br>6. Dinner (6:30 PM - 7:45)<br>7. Supper (10:00 PM - 11:30 PM)
                </div>
                <div class="bg-blue-50 p-4 rounded-lg text-blue-900 border border-blue-200 shadow-sm">
                    <strong class="block text-sm font-bold mb-1 text-app-blue">🕌 Friday Schedule</strong>
                    1. Breakfast (6:30 - 7:15)<br>2. Teabreak (9:45 - 10:15)<br>3. Lunch (12:15 - 1:15)<br>4. Evening tea (4:15 - 5:00)<br>6. Dinner (6:30 PM - 7:45)<br>7. Supper (10:00 PM - 11:30 PM)
                </div>
                <div class="bg-red-50 p-4 rounded-lg text-red-900 border border-red-200 shadow-sm">
                    <strong class="block text-sm font-bold mb-1 text-app-red">🏡 Weekend (Sat & Sun)</strong>
                    1. Breakfast (6:30 - 7:15)<br>2. Teabreak (9:30 - 10:00)<br>3. Lunch (12:00 - 01:00)<br>4. Evening tea (4:15 - 5:00)<br>6. Dinner with supper (6:30 PM - 7:45)
                </div>
            </div>

            <!-- Detailed Schedule & Menu Container -->
            <div id="schedule-container" class="space-y-6">
                <!-- Dynamically populated via JS -->
            </div>
        </section>

        <!-- 4. FEEDBACK HUB TAB -->
        <section id="tab-feedback" class="hidden space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Submission Form -->
                <div class="bg-white p-6 rounded-xl shadow border-t-4 border-app-red md:col-span-1">
                    <h2 class="text-xl font-bold text-app-textDark mb-2">Student Feedback Hub</h2>
                    <p class="text-xs text-gray-500 mb-4">Report food quality issues (e.g., undercooked rice, raw chicken) or suggest menu improvements.</p>
                    
                    <form id="feedback-form" onsubmit="submitFeedback(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Feedback Category</label>
                            <select id="fb-category" class="w-full text-sm border rounded p-2 focus:ring-app-blue focus:outline-none">
                                <option value="Quality Issue (Raw/Undercooked)">⚠️ Quality Issue (Raw / Undercooked)</option>
                                <option value="Taste & Portion">🍲 Taste & Portion Size</option>
                                <option value="Menu Suggestion">💡 Menu Suggestion</option>
                                <option value="Cleanliness / Hygiene">✨ Cleanliness & Hygiene</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Meal Time</label>
                            <select id="fb-meal" class="w-full text-sm border rounded p-2 focus:ring-app-blue focus:outline-none">
                                <option value="Breakfast">Breakfast</option>
                                <option value="Teabreak">Teabreak</option>
                                <option value="Lunch">Lunch</option>
                                <option value="Evening Tea">Evening Tea</option>
                                <option value="Dinner">Dinner</option>
                                <option value="Supper">Supper</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Your Comments / Details</label>
                            <textarea id="fb-text" rows="3" required placeholder="Describe the issue or suggestion clearly..." class="w-full text-sm border rounded p-2 focus:ring-app-blue focus:outline-none"></textarea>
                        </div>
                        <div class="flex items-center space-x-2">
                            <input type="checkbox" id="fb-anon" class="rounded text-app-red focus:ring-app-red">
                            <label for="fb-anon" class="text-xs font-medium text-gray-700">Submit Anonymously</label>
                        </div>
                        <button type="submit" class="w-full bg-app-red text-white font-bold py-2 rounded text-sm hover:bg-app-darkRed transition shadow">Submit Feedback</button>
                    </form>
                </div>

                <!-- Live Feedback Feed -->
                <div class="bg-white p-6 rounded-xl shadow border-t-4 border-app-blue md:col-span-2 flex flex-col">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-lg font-bold text-app-textDark">Recent Student Feedback & Staff Responses</h3>
                        <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded font-medium">Real-time Feed</span>
                    </div>
                    <div id="feedback-feed" class="space-y-4 overflow-y-auto max-h-[500px] pr-2">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- 5. STAFF PORTAL PASSWORD MODAL -->
    <div id="staff-modal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden">
        <div class="bg-white p-6 rounded-xl shadow-2xl max-w-sm w-full mx-4 border-t-8 border-app-red">
            <h3 class="text-xl font-bold text-app-textDark mb-2">Staff Portal Access</h3>
            <p class="text-xs text-gray-500 mb-4">Please enter the kitchen staff / food committee passcode (Passcode: <code class="bg-gray-100 px-1 py-0.5 rounded font-bold text-app-red">1234</code>)</p>
            <input type="password" id="staff-passcode" placeholder="Enter PIN..." class="w-full border p-2 rounded text-center text-lg tracking-widest mb-4 focus:outline-none focus:ring-2 focus:ring-app-blue" maxlength="4">
            <div class="flex space-x-2">
                <button onclick="closeStaffModal()" class="w-1/2 bg-gray-200 text-gray-700 font-bold py-2 rounded text-sm hover:bg-gray-300">Cancel</button>
                <button onclick="verifyStaff()" class="w-1/2 bg-app-red text-white font-bold py-2 rounded text-sm hover:bg-app-darkRed">Enter Portal</button>
            </div>
            <p id="passcode-error" class="text-xs text-red-600 font-bold text-center mt-3 hidden">Incorrect passcode! Try 1234.</p>
        </div>
    </div>

    <!-- 6. STAFF DASHBOARD MODAL -->
    <div id="staff-dashboard" class="fixed inset-0 bg-black bg-opacity-60 z-50 flex items-center justify-center hidden">
        <div class="bg-white w-full max-w-4xl h-[90vh] rounded-xl shadow-2xl flex flex-col overflow-hidden border-t-8 border-app-blue">
            <div class="bg-app-textDark text-white p-4 flex justify-between items-center">
                <div>
                    <h3 class="text-lg font-bold">Staff & Kitchen Committee Management Dashboard</h3>
                    <p class="text-xs text-gray-400">Manage menu items, review complaints, and issue official replies.</p>
                </div>
                <button onclick="closeDashboard()" class="text-white hover:text-app-red text-xl font-bold">&times;</button>
            </div>
            <div class="p-6 overflow-y-auto space-y-6 flex-grow bg-gray-50">
                <div class="bg-white p-5 rounded-lg shadow border">
                    <h4 class="font-bold text-app-textDark mb-3 text-sm">Quick Menu Override (Today)</h4>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <input type="text" id="override-main" placeholder="Update Main Dish..." class="border p-2 text-xs rounded">
                        <input type="text" id="override-side" placeholder="Update Side/Veg..." class="border p-2 text-xs rounded">
                        <button onclick="saveMenuOverride()" class="bg-app-red text-white text-xs font-bold py-2 rounded hover:bg-app-darkRed">Apply Menu Change</button>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-lg shadow border">
                    <h4 class="font-bold text-app-textDark mb-3 text-sm">Actionable Student Feedback & Complaint Management</h4>
                    <div id="staff-feedback-list" class="space-y-3">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-app-textDark text-white py-6 mt-12 border-t-2 border-app-red text-center text-xs">
        <p class="font-semibold text-gray-300">MakanMate &bull; Boarding School Dining Portal</p>
        <p class="text-gray-500 mt-1">Nourishing excellence, discipline, and healthy student lifestyles.</p>
    </footer>

