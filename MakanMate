
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MakanMate | Boarding School Dining Portal</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        app: {
                            red: '#DC2626',      // Vibrant Red
                            darkRed: '#991B1B',  // Deep Red / Maroon
                            blue: '#2563EB',     // Royal Blue
                            darkBlue: '#1E40AF', // Dark Blue
                            grey: '#F3F4F6',     // Light Grey Background
                            cardGrey: '#E5E7EB', // Border / Card Grey
                            textDark: '#111827'  // Black / Dark Slate
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-app-grey text-app-textDark font-sans min-h-screen flex flex-col">

    <!-- Header / Navigation -->
